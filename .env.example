# ==========================================================
#  Copiez ce fichier en .env, puis remplissez les valeurs :
#      cp .env.example .env
#
#  .env est ignore par git : il ne sera JAMAIS commite.
#  Ce fichier-ci ne contient QUE des noms de variables et des exemples.
# ==========================================================

# ----------------------------------------------------------
#  LE FOURNISSEUR D'IA
#
#  L'application fonctionne avec n'importe quelle API au format
#  "compatible OpenAI" — c'est-a-dire la quasi-totalite d'entre elles.
#  Vous n'avez AUCUNE ligne de code a modifier : ces trois variables suffisent.
# ----------------------------------------------------------

# 1. L'adresse du fournisseur.
#    Verifie et teste par nous : Anthropic.
#    Les autres adresses ci-dessous sont donnees a titre indicatif,
#    verifiez-les dans la documentation de votre fournisseur.
#
#      Anthropic  https://api.anthropic.com/v1/
#      OpenAI     https://api.openai.com/v1/
#      Mistral    https://api.mistral.ai/v1/
#      Groq       https://api.groq.com/openai/v1/
#      Ollama     http://localhost:11434/v1/     (modeles locaux, cle bidon)
LLM_BASE_URL=https://api.anthropic.com/v1/

# 2. Votre cle d'API chez ce fournisseur.
LLM_API_KEY=remplacez-moi

# 3. Le nom du modele, tel que VOTRE fournisseur l'appelle.
#      Anthropic  claude-haiku-4-5  (rapide et peu cher)
#                 claude-opus-5     (le plus capable)
#      OpenAI     gpt-...           (voir leur documentation)
#      Mistral    mistral-small-latest
LLM_MODEL=claude-haiku-4-5

# 4. Plafond de tokens par reponse. Garde-fou, pas une facturation :
#    on ne paie que ce qui est reellement produit.
LLM_MAX_TOKENS=1000


# ----------------------------------------------------------
#  Utilise a partir du palier 3, inutile pour le palier 2
# ----------------------------------------------------------
# Fichier SQLite (donnees metier + journal d'audit).
DATABASE_URL=sqlite:///./lebras.db
# Dossier ou notre faux service de messagerie ecrira les messages "envoyes".
OUTBOX_DIR=./outbox
