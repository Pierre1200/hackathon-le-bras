# ==========================================================
#  Copiez ce fichier en .env puis remplissez les valeurs :
#      cp .env.example .env
#  Le fichier .env est ignore par git (voir .gitignore).
#  Ce fichier-ci ne contient QUE des noms de variables et des exemples bidons.
# ==========================================================

# Cle d'API du fournisseur de modele.
# A recuperer sur la console du fournisseur. Ne la collez jamais ici.
LLM_API_KEY=sk-remplacez-moi

# Nom du modele utilise par le planificateur.
LLM_MODEL=nom-du-modele

# Chemin du fichier SQLite (donnees metier + journal d'audit).
DATABASE_URL=sqlite:///./lebras.db

# Dossier ou notre faux service de messagerie ecrit les messages "envoyes".
# C'est un vrai dossier sur le disque : c'est notre simulation assumee.
OUTBOX_DIR=./outbox

# Port du serveur back.
PORT=8000
