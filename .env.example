# ==========================================================
#  Copiez ce fichier en .env, puis remplissez les valeurs :
#      cp .env.example .env
#
#  .env est ignore par git (voir .gitignore) : il ne sera JAMAIS commite.
#  Ce fichier-ci ne contient QUE des noms de variables et des exemples bidons.
# ==========================================================

# Cle d'API du fournisseur de modele.
# Ce nom exact est important : le SDK la cherche sous ce nom precis.
ANTHROPIC_API_KEY=sk-remplacez-moi

# Le modele utilise. C'est LA ligne a changer pour changer de modele :
# aucune modification de code n'est necessaire.
#   claude-opus-5     -> le plus capable (par defaut)
#   claude-haiku-4-5  -> le plus rapide et le moins cher, pratique en dev
LLM_MODEL=claude-opus-5

# ---- Utilise a partir du palier 3, inutile pour le palier 2 ----
# Fichier SQLite (donnees metier + journal d'audit).
DATABASE_URL=sqlite:///./lebras.db
# Dossier ou notre faux service de messagerie ecrira les messages "envoyes".
OUTBOX_DIR=./outbox
